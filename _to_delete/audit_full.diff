+    output.append(
+        "  Elite Four: "
+        + " -> ".join(
+            f"{name} L{party_ace(parties, label, party_no)}"
+            for name, label, party_no in ELITE_FOUR_REMATCHES
+        )
+    )
+    output.append(
+        "  Finale: "
+        + " -> ".join(
+            f"{name} L{party_ace(parties, label, party_no)}"
+            for name, label, party_no in POSTGAME_FINALE
+        )
